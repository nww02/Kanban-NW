<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- Remove unused platform DLLs after publish -->
  <Target Name="RemoveUnusedPlatformDlls" AfterTargets="Publish">
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <_RemoveDlls Include="$(PublishDir)Avalonia.Win32.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Win32.Automation.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Native.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Metal.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.DesignerSupport.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Remote.Protocol.dll" />
    </ItemGroup>
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
      <_RemoveDlls Include="$(PublishDir)Avalonia.X11.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.FreeDesktop.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.FreeDesktop.AtSpi.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Native.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Metal.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.DesignerSupport.dll" />
      <_RemoveDlls Include="$(PublishDir)Tmds.DBus.Protocol.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.OpenGL.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Vulkan.dll" />
      <_RemoveDlls Include="$(PublishDir)Avalonia.Remote.Protocol.dll" />
    </ItemGroup>
    <Delete Files="@(_RemoveDlls)" />
  </Target>

  <!-- ZIP the publish folder as KanbanNW-<version>-<OS>-<arch>.zip -->
  <Target Name="ZipPublishOutput" AfterTargets="RemoveUnusedPlatformDlls"
          Condition="$(RuntimeIdentifier) != ''">
    <PropertyGroup>
      <_Rid>$(RuntimeIdentifier)</_Rid>
      <_DashPos>$(_Rid.IndexOf('-'))</_DashPos>
      <_OsPart>$(_Rid.Substring(0, $(_DashPos)))</_OsPart>
      <_ArchPart>$(_Rid.Substring($([MSBuild]::Add($(_DashPos), 1))))</_ArchPart>
      <_OsTitle>$(_OsPart.Substring(0,1).ToUpper())$(_OsPart.Substring(1))</_OsTitle>
      <_ZipName>KanbanNW-$(Version)-$(_OsTitle)-$(_ArchPart).zip</_ZipName>
      <_ZipPath>$([System.IO.Path]::GetFullPath('$(OutputPath)../'))$(_ZipName)</_ZipPath>
    </PropertyGroup>
    <Delete Files="$(_ZipPath)" Condition="Exists('$(_ZipPath)')" />
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(_ZipPath)"
                  Overwrite="true" />
    <Message Importance="high" Text="Published ZIP: $(_ZipPath)" />
  </Target>
</Project>
