<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KanbanNW.Views.ConfirmDialog"
        Title="Confirm"
        Width="380"
        Height="160"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap"
                   VerticalAlignment="Center" FontSize="14"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Delete" Width="80" Click="OnConfirm"
                    Background="#EF5350" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>