<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        x:Class="KanbanNW.Views.ColumnsEditorWindow"
        x:DataType="vm:ColumnsEditorViewModel"
        Title="Manage Columns"
        Width="400"
        Height="350"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ListBox Grid.Row="0" ItemsSource="{Binding Columns}"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ColumnItem">
                    <Border Padding="8,6" BorderBrush="{DynamicResource SubtleBorderColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" >
                            <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="14"
                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                     IsReadOnly="{Binding IsSystem}"/>
                            <Button Grid.Column="1" Content="&#x2715;"
                                    Command="{Binding $parent[Window].((vm:ColumnsEditorViewModel)DataContext).DeleteColumnCommand}"
                                    CommandParameter="{Binding}"
                                    FontSize="12" Padding="4,1" Background="Transparent"
                                    Foreground="#EF5350"
                                    IsVisible="{Binding IsSystem, Converter={StaticResource InverseBool}}"
                                    ToolTip.Tip="Delete column"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Command="{Binding AddColumnCommand}" Content="+ Add Column" Margin="0,0,12,0"
                    Background="Transparent"/>
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Save" Width="80" Click="OnSave" Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>
