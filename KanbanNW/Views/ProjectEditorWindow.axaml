<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        x:Class="KanbanNW.Views.ProjectEditorWindow"
        x:DataType="vm:ProjectEditorViewModel"
        Title="Manage Projects"
        Width="520"
        Height="380"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ListBox Grid.Row="0" ItemsSource="{Binding Projects}"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ProjectItem">
                    <Border Padding="8,6" BorderBrush="{DynamicResource SubtleBorderColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto" >
                            <!-- Color swatch indicator -->
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4"
                                    Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnColorSwatchClick"
                                    Tag="{Binding $parent[Window].((vm:ProjectEditorViewModel)DataContext).ColorOptions}"
                                    Cursor="Hand"
                                    ToolTip.Tip="Click to change color"/>
                            <!-- Project name -->
                            <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Delete button -->
                            <Button Grid.Column="2" Content="&#x2715;"
                                    Command="{Binding $parent[Window].((vm:ProjectEditorViewModel)DataContext).DeleteProjectCommand}"
                                    CommandParameter="{Binding}"
                                    FontSize="12" Padding="4,1" Background="Transparent" Foreground="#EF5350"
                                    ToolTip.Tip="Delete project"/>
                        </Grid>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Command="{Binding AddProjectCommand}" Content="+ Add Project" Margin="0,0,12,0"
                    Background="Transparent"/>
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Save" Width="80" Click="OnSave" Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>