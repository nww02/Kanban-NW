<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        xmlns:models="using:KanbanNW.Models"
        x:Class="KanbanNW.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Kanban Board"
        Width="1200"
        Height="800"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBarBackground}" Height="28">
            <MenuItem Header="_Kanban" Classes="menu-header">
                <MenuItem Header="_Export Project..." Classes="submenu-item"
                          Command="{Binding ExportProjectCommand}"/>
                <MenuItem Header="_Exit" Classes="submenu-item" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Config" Classes="menu-header">
                <MenuItem Header="_Categories..." Classes="submenu-item" Click="OnCategoriesClick"/>
                <MenuItem Header="_Columns..." Classes="submenu-item" Click="OnColumnsClick"/>
                <MenuItem Header="_Projects..." Classes="submenu-item" Click="OnProjectsClick"/>
                <MenuItem Header="Show _Deleted" Classes="submenu-item"
                          Click="OnToggleShowDeleted"
                          Icon="{Binding ShowDeletedTasks, Converter={StaticResource BoolToCheckmark}}"/>
                <MenuItem Header="_Appearance..." Classes="submenu-item" Click="OnAppearanceClick"/>
            </MenuItem>
            <!-- Spacer to push Help menu to the right -->
            <TextBlock/>
            <MenuItem Header="_Help" Classes="menu-header" HorizontalAlignment="Right">
                <MenuItem Header="_Help" Classes="submenu-item" Click="OnHelpClick"/>
                <Separator/>
                <MenuItem Header="_About" Classes="submenu-item" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="0" Background="{DynamicResource TabBarColor}">
            <Grid RowDefinitions="Auto" Margin="0">
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Projects}" Margin="8,0,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:KanbanProject">
                            <Border Padding="16,8" Margin="0,0,2,0"
                                    Background="{Binding Color, Converter={StaticResource StringToBrush}}"
                                    CornerRadius="6,6,0,0"
                                    PointerPressed="OnProjectTabClick"
                                    Tag="{Binding Id}"
                                    Cursor="Hand">
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TabFontSize}" FontWeight="600"
                                           Classes="tab-text"
                                           Foreground="{Binding Color, Converter={StaticResource ContrastText}}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="OnColumnDragOver">
            <ItemsControl x:Name="ColumnsItemsControl"
                          ItemsSource="{Binding Columns}"
                          Margin="16,16"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="OnColumnDragOver">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ColumnViewModel">
                        <Border Width="300"
                                Classes="task-column"
                                CornerRadius="8"
                                Padding="0"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnColumnDragOver"
                                DragDrop.Drop="OnColumnDrop"
                                Margin="0,0,16,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="12,10"
                                        Background="{DynamicResource ColumnHeaderBgCol}">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="700" FontSize="{DynamicResource ColumnHeaderFontSize}"
                                                   Classes="column-header"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddTaskToColumnCommand}"
                                                CommandParameter="{Binding}"
                                                Content="+ Add Task"
                                                FontSize="{DynamicResource AddTaskBtnFontSize}"
                                                Padding="6,2" Margin="0,0,6,0"
                                                Background="Transparent" FontWeight="600"
                                                Classes="column-header"
                                                IsVisible="{Binding Name, Converter={StaticResource CanAddTaskConverter}}"/>
                                        <Button Grid.Column="2"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EmptyQueueCommand}"
                                                Content="Empty Queue"
                                                FontSize="{DynamicResource EmptyQueueBtnFontSize}"
                                                Padding="6,2" Margin="0,0,6,0"
                                                Background="#EF5350" Foreground="White" CornerRadius="3"
                                                IsVisible="{Binding Name, Converter={StaticResource IsDeletedColumn}}"/>
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding Tasks}"
                                         BorderThickness="0" Background="Transparent" Margin="6,6"
                                         DragDrop.AllowDrop="True"
                                         DragDrop.DragOver="OnColumnDragOver"
                                         DragDrop.Drop="OnTaskDrop">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:TaskViewModel">
                                            <Border Background="{DynamicResource TaskBackground}" CornerRadius="6" Padding="0"
                                                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                                                    PointerPressed="OnTaskPointerPressed"
                                                    HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="8,*">
                                                    <!-- Placeholder view: empty bordered box when IsDragPlaceholder -->
                                                    <Border Grid.ColumnSpan="2"
                                                            IsVisible="{Binding IsDragPlaceholder}"
                                                            BorderBrush="#4A90D9" BorderThickness="2"
                                                            CornerRadius="6"
                                                            Height="{Binding PlaceholderHeight}"
                                                            Background="#E0E0E0" Opacity="0.7"/>
                                                    <!-- Color strip -->
                                                    <Border Grid.Column="0"
                                                            Background="{Binding Type, Converter={StaticResource TypeToColor}}"
                                                            CornerRadius="6,0,0,6"
                                                            IsVisible="{Binding IsDragPlaceholder, Converter={StaticResource InverseBool}}"/>
                                                    <DockPanel Grid.Column="1" Margin="10,8,8,8"
                                                        IsVisible="{Binding IsDragPlaceholder, Converter={StaticResource InverseBool}}">
                                                        <TextBlock DockPanel.Dock="Top"
                                                                   Text="{Binding Title}" FontWeight="700"
                                                                   FontSize="{DynamicResource TaskTitleFontSize}" TextWrapping="Wrap"
                                                                   Classes="task-title"
                                                                   TextDecorations="{Binding IsComplete, Converter={StaticResource BoolToStrikethrough}}"/>
                                                        <TextBlock DockPanel.Dock="Top"
                                                                   Text="{Binding Description, Converter={StaticResource DescriptionPreview}}"
                                                                   FontSize="{DynamicResource TaskDescFontSize}" Classes="task-excerpt"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="42" Margin="0,4,0,4"
                                                                   IsVisible="{Binding Description, Converter={StaticResource StringNotEmpty}}"/>
                                                        <Border DockPanel.Dock="Top"
                                                                Background="{Binding DueDateColor}"
                                                                CornerRadius="3" Padding="6,2"
                                                                IsVisible="{Binding DueDate, Converter={StaticResource NotNullConverter}}"
                                                                Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToString}}"
                                                                       FontSize="{DynamicResource DueDateFontSize}" Foreground="White"/>
                                                        </Border>
                                                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                                            <Border Grid.Column="0"
                                                                    Background="{Binding Type, Converter={StaticResource TypeToColor}}"
                                                                    CornerRadius="3" Padding="8,3"
                                                                    HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Type, Converter={StaticResource TypeToDisplayName}}"
                                                                           FontSize="{DynamicResource DueDateFontSize}" Foreground="White"/>
                                                            </Border>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveTaskToDoneCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="&#x2713;" FontSize="{DynamicResource TaskButtonFontSize}"
                                                                    Padding="4,2" Background="#E8F5E9"
                                                                    Margin="0,0,4,0" ToolTip.Tip="Mark as complete"
                                                                    IsVisible="{Binding IsComplete, Converter={StaticResource InverseBool}}"/>
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="&#x270f;" FontSize="{DynamicResource TaskButtonFontSize}"
                                                                    Padding="4,2" Background="Transparent"
                                                                    Margin="0,0,4,0" ToolTip.Tip="Edit task"/>
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteTaskCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="&#x2715;" FontSize="{DynamicResource TaskButtonFontSize}"
                                                                    Padding="4,2" Background="Transparent"
                                                                    Foreground="#EF5350" ToolTip.Tip="Delete task"/>
                                                        </Grid>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Drag overlay – renders on top of everything, events pass through.
             Used to host the floating task visual during drag. -->
        <Canvas Name="DragOverlay" IsHitTestVisible="False" Background="Transparent" ZIndex="10000"/>
    </DockPanel>
</Window>
