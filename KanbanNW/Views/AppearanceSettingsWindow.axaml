<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        x:Class="KanbanNW.Views.AppearanceSettingsWindow"
        x:DataType="vm:AppearanceSettingsViewModel"
        Title="Appearance Settings"
        Width="520"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="10">

                <TextBlock Text="Presets" FontWeight="700" FontSize="16" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Theme:" Width="180" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              Width="240" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Font Preset:" Width="180" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding FontPresets}" SelectedItem="{Binding SelectedFontPreset}"
                              Width="240" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Font" FontWeight="700" FontSize="16" Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Font Family:" Width="180" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                              Width="240" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Font Sizes" FontWeight="700" FontSize="16" Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Tab Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TabFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 18)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Column Header Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ColumnHeaderFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 18)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Task Title Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TaskTitleFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 16)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Task Description Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TaskDescFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Button Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TaskButtonFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Due Date Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DueDateFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Add Task Button Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AddTaskBtnFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Empty Queue Btn Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding EmptyQueueBtnFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Task Editor Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TaskEditorFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Base Font Size:" Width="180" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding BaseFontSize}" Width="60" VerticalAlignment="Center"/>
                    <TextBlock Text="(default 14)" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Reset to Defaults" Width="130" Click="OnReset"/>
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Save" Width="80" Click="OnSave" Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>