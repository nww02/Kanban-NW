<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        x:Class="KanbanNW.Views.ColorPickerDialog"
        Title="Pick a Color"
        Width="480"
        Height="480"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True">
    <DockPanel Margin="8" LastChildFill="True">
        <Button DockPanel.Dock="Bottom" Content="OK" Click="OnOk" HorizontalAlignment="Right" Width="80" Margin="0,8,0,0"/>
        <!--Border x:Name="PreviewBorder" DockPanel.Dock="Bottom" Height="0" CornerRadius="4" Margin="0,0,0,8"/-->
        <c:ColorView x:Name="ColorViewControl" Width="340" Height="400" Margin="0,0,0,4"/>
    </DockPanel>
</Window>