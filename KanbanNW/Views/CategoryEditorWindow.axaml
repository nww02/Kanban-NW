<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        xmlns:conv="using:KanbanNW.Converters"
        x:Class="KanbanNW.Views.CategoryEditorWindow"
        x:DataType="vm:CategoryEditorViewModel"
        Title="Edit Category Names"
        Width="460"
        Height="400"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:TypeToColorNameConverter x:Key="TypeToColorName"/>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ListBox Grid.Row="0" ItemsSource="{Binding Categories}"
                 BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:CategoryItem">
                    <Border Padding="8,6" BorderBrush="{DynamicResource SubtleBorderColor}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Color swatch -->
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4"
                                    Background="{Binding Type, Converter={StaticResource TypeToColor}}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Enum name (read-only) -->
                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{DynamicResource HintForeground}" Margin="0,0,10,0"/>

                            <!-- Editable display name -->
                            <TextBox Grid.Column="2" Text="{Binding DisplayName}" Width="180"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Command="{Binding ResetToDefaultsCommand}" Content="Reset to Defaults" Width="120"
                    Background="Transparent"/>
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Save" Width="80" Click="OnSave" Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>