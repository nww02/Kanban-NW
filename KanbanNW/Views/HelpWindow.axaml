<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        x:Class="KanbanNW.Views.HelpWindow"
        x:DataType="vm:HelpViewModel"
        Title="Kanban-NW Help"
        Width="750"
        Height="520"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid ColumnDefinitions="180,*" Margin="0">
        <!-- Topic list -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Topics}"
                 SelectedItem="{Binding SelectedTopic}"
                 BorderThickness="0,0,1,0"
                 BorderBrush="{DynamicResource BorderColor}"
                 Background="Transparent"
                 Margin="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:HelpTopic">
                    <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,6"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" Margin="20,16">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding SelectedTopic.Title}"
                           FontSize="20" FontWeight="700"
                           IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Text="{Binding SelectedTopic.Content}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           IsVisible="{Binding SelectedTopic, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
