<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KanbanNW.ViewModels"
        xmlns:models="using:KanbanNW.Models"
        xmlns:conv="using:KanbanNW.Converters"
        x:Class="KanbanNW.Views.TaskEditorWindow"
        x:DataType="vm:TaskEditorViewModel"
        Title="{Binding IsEditing, Converter={StaticResource EditNewTitle}}"
        Width="700"
        Height="550"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,240" Margin="16">
        <!-- Left panel: Main form -->
        <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0">
            <TextBox Text="{Binding Title}"
                     PlaceholderText="Task title"
                     FontSize="{DynamicResource TaskEditorFontSize}"
                     FontWeight="600"/>

            <!-- Type selector -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Type:" VerticalAlignment="Center" FontSize="{DynamicResource BaseFontSize}"/>
                <ComboBox ItemsSource="{Binding TaskTypes}"
                          SelectedItem="{Binding SelectedTypeItem}"
                          Width="160">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:TaskTypeDisplay">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3"
                                        Background="{Binding Type, Converter={StaticResource TypeToColor}}"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Due date + clear button -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Due date:" VerticalAlignment="Center" FontSize="{DynamicResource BaseFontSize}"/>
                <DatePicker SelectedDate="{Binding DueDate}" Width="160"/>
                <Button Content="&#x1f5d1;" Width="28" Height="28" FontSize="14"
                        Padding="2" Background="Transparent"
                        ToolTip.Tip="Clear due date"
                        Command="{Binding ClearDueDateCommand}"/>
            </StackPanel>

            <!-- Estimated days -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Estimated days:" VerticalAlignment="Center" FontSize="{DynamicResource BaseFontSize}"/>
                <TextBox Text="{Binding EstimatedDays}" Width="60" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Description with wrapping -->
            <TextBox Text="{Binding Description}"
                     PlaceholderText="Description"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="120"
                     MaxHeight="180"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Right panel: Comments -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Comments" FontWeight="700" FontSize="15" Margin="0,0,0,8"/>

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewCommentText}"
                             PlaceholderText="Add a comment..."
                             Margin="0,0,8,0"
                             AcceptsReturn="False"/>
                    <Button Grid.Column="1"
                            Command="{Binding AddCommentCommand}"
                            Content="Add"/>
                </Grid>

                <ListBox ItemsSource="{Binding Comments}"
                         BorderThickness="0" Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:Comment">
                            <Border BorderBrush="{DynamicResource SubtleBorderColor}" BorderThickness="0,0,0,1" Padding="4,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                    <TextBlock Text="{Binding CreatedAt}"
                                               FontSize="11" Foreground="{DynamicResource HintForeground}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Bottom action buttons -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Command="{Binding CancelCommand}" Content="Cancel" Width="80"/>
            <Button Command="{Binding SaveCommand}" Content="Save" Width="80"
                    Classes="Primary"/>
        </StackPanel>
    </Grid>
</Window>