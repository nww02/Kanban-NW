<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KanbanNW.Views.AboutWindow"
        Title="About Kanban-NW"
        Width="400"
        Height="320"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Spacing="12" Margin="24,20">

        <TextBlock Text="Kanban-NW"
                   FontSize="22" FontWeight="700" HorizontalAlignment="Center"/>

        <TextBlock Text="Version 1.0.2"
                   FontSize="13" HorizontalAlignment="Center"
                   Foreground="{DynamicResource HintForeground}"/>

        <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center"
                   Margin="0,4,0,0" FontSize="13"
                   Text="A lightweight, local kanban board application for organising tasks into columns and tracking progress."/>

        <Border Height="1" Background="{DynamicResource SubtleBorderColor}" Margin="0,4"/>

        <TextBlock TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource HintForeground}"
                   TextAlignment="Center"
                   Text="This software is provided 'as is' without warranty of any kind, either express or implied, including but not limited to the implied warranties of merchantability and fitness for a particular purpose. The authors or copyright holders shall not be liable for any claim, damages, or other liability, whether in an action of contract, tort, or otherwise, arising from, out of, or in connection with the software or the use or other dealings in the software. Use at your own risk."/>

        <Button Content="Close" Width="80" HorizontalAlignment="Center"
                Margin="0,8,0,0" Click="OnClose" Classes="Primary"/>
    </StackPanel>
</Window>
